{
  "branches":
  [
    "+([0-9])?(.{+([0-9]),x}).x",
    "main",
    { name: "next", channel: "alpha", prerelease: "alpha" },
    { name: "develop", channel: "beta", prerelease: "beta" },
  ],
    plugins:
  [
    "@semantic-release/commit-analyzer",
    [
      "@google/semantic-release-replace-plugin",
      {
        "replacements": [          
          {
            "files": ["pyproject.toml"],
            "from": "^version ?=.*",
            "to": "version = \"${nextRelease.version}\"",
            "results": [
              {
                "file": "pyproject.toml",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          }
        ]
      }
    ],
    # Runs after the replace plugin has stamped pyproject.toml, so
    # `uv lock` sees the new version and rewrites the one line of the
    # lock that records it. Offline on purpose: the cache is warm from
    # the `uv sync --frozen` earlier in this job, and a release must not
    # be able to re-resolve dependencies from the network on its way out.
    ["@semantic-release/exec", {
      "prepareCmd": 'yq -i eval ".appVersion = \"${nextRelease.version}\"" charts/mibserver/Chart.yaml;yq -i eval ".version = \"${nextRelease.version}\"" charts/mibserver/Chart.yaml;uv lock --offline'
    }],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/git",
      {
        "assets": ["NOTICE", "charts/mibserver/Chart.yaml", "pyproject.toml", "uv.lock"],
        "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}",
        },
    ],
    ["@semantic-release/github", { "assets": ["NOTICE"] }],
  ],
}