# Copyright 2021 Splunk Inc.
repositoryUrl: https://github.com/splunk/mibs.git
tagFormat: v${version}
branches:
  - "+([0-9])?(.{+([0-9]),x}).x"
  - main
  - name: next
    channel: alpha
    prerelease: alpha
  - name: develop
    channel: beta
    prerelease: beta
plugins:
  - "@semantic-release/commit-analyzer"
  - - "@google/semantic-release-replace-plugin"
    - replacements:
        - files: [pyproject.toml]
          from: "^version ?=.*"
          to: 'version = "${nextRelease.version}"'
          results:
            - file: pyproject.toml
              hasChanged: true
              numMatches: 1
              numReplacements: 1
          countMatches: true
  - - "@semantic-release/exec"
    - prepareCmd: >-
        yq -i eval ".appVersion = \"${nextRelease.version}\"" charts/mibserver/Chart.yaml &&
        yq -i eval ".version = \"${nextRelease.version}\"" charts/mibserver/Chart.yaml
  - "@semantic-release/release-notes-generator"
  - - "@semantic-release/git"
    - assets:
        - charts/mibserver/Chart.yaml
        - pyproject.toml
      message: "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
  - "@semantic-release/github"
