{
  "version": 1,
  "publications": [
    {
      "name": "github-pages",
      "emit": [
        "asn1", "json", "index", "index-v2", "standard",
        "closure", "arcs", "report"
      ],
      "output": "github-pages"
    },
    {
      "name": "depot-site",
      "emit": ["site", "entity", "report"],
      "output": "depot-site"
    },
    {
      "name": "depot-data",
      "emit": [
        "asn1", "json-texts", "index", "index-v2", "standard",
        "closure", "arcs", "search-db", "report"
      ],
      "output": "depot-data"
    }
  ],
  "site": {
    "base-url": "https://mibsdepot.com",
    "data-url": "https://data.mibsdepot.com",
    "description": "5,510 SNMP MIB modules from their publishers, rendered as pages: one per module, one per OID arc, one per registrant, carrying the DESCRIPTION text the files themselves hold. The same corpus is downloadable as ASN.1 and JSON from https://data.mibsdepot.com.",
    "name": "MIBs Depot",
    "template": "theme/page.html",
    "stylesheet": "theme/style.css",
    "page-size": { "browse": 500, "entity": 200 }
  },
  "expect": {
    "modules": { "min": 5000 },
    "failures": { "max": 25 },
    "namespaces-present": ["standard"]
  },
  "namespaces": [
    {
      "name": "standard",
      "source": "package:pysmi.mibs.asn1",
      "tier": "standard"
    },
    {
      "include": "src/vendor/*",
      "tier": "vendor"
    }
  ]
}
