    "oid": "1.3.6.1.4.1.11.2.14.10.2.14",
    "class": "moduleidentity",
    "revisions": [
      {
        "revision": "2007-08-29 11:20",
        "description": "Deprecated all bps objects for hpEgressRateLimitPortConfigTable and hpIngressRateLimitPortConfigTable, and updated compliance information (including correcting ICMP group to be hpICMPRateLimitPortConfigGroup2)."
      },
      {
        "revision": "2007-07-27 19:20",
        "description": "Modified enumerated type names for hpICMPRateLimitPortControlMode object."
      },
      {
        "revision": "2007-06-01 11:46",
        "description": "Deprecated hpICMPRateLimitPortState in favor of new hpICMPRateLimitPortControlMode object."
      },
      {
        "revision": "2007-05-30 16:10",
        "description": "Added Kbps configuration for ICMP, port-egress, and port-ingress rate-limiting definitions."
      },
      {
        "revision": "2006-07-07 18:33",
        "description": "Added new egress rate limiting bps objects, and ingress rate-limiting definitions."
      },
      {
        "revision": "2005-04-20 11:30",
        "description": "Added minimum bandwidth and egress rate limiting definitions."
      },
      {
        "revision": "2004-08-22 10:30",
        "description": "Initial version."
      }
    ]
  },
