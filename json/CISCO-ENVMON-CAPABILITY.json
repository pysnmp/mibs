  "ciscoEnvMonCapability": {
    "name": "ciscoEnvMonCapability",
    "oid": "1.3.6.1.4.1.9.7.33",
    "class": "moduleidentity",
    "revisions": [
      {
        "revision": "2009-12-16 00:00",
        "description": "Added agent capabilities for Wireless LAN Controllers."
      },
      {
        "revision": "2009-01-05 00:00",
        "description": "Added agent capabilities for TelePresence platforms."
      },
      {
        "revision": "2007-05-18 00:00",
        "description": "The following capability statements have been added: 1. ciscoEnvMonCapV12R05TP28xx 2. ciscoEnvMonCapV12R05TP3825 3. ciscoEnvMonCapV12R05TP3845 4. ciscoEnvMonCapV12R05TP1841Rev1 ciscoEnvMonCapV12R05TP1841 has been made obsolete by ciscoEnvMonCapV12R05TP1841Rev1. ciscoEnvMonCapV12R05TPMARS has been updated to indicate the platforms this capability statement is applicable to."
      },
      {
        "revision": "2006-12-12 00:00",
        "description": "Added VARIATION for ciscoEnvMonMIBGroupRev, ciscoEnvMonMIBMiscNotifGroup and ciscoEnvMonStatChangeNotifGroup with PCBU platform routers (180x, 181x, 1841 & 2801)."
      },
      {
        "revision": "2006-07-19 00:00",
        "description": "Added VARIATION for ciscoEnvMonStatChangeNotifGroup to MARs platform routers (26xx, 28xx, 37xx, 38xx, IAD243x and VG224)."
      },
      {
        "revision": "2006-04-19 00:00",
        "description": "Added VARIATION for ciscoEnvMonTemperatureLastShutdown to agent capability statement ciscoEnvMonCapV12R0119ECat6K."
      },
      {
        "revision": "2004-12-16 01:00",
        "description": "Added agent capabilities for 38xx, 37xx, 26xx, 28xx, VG224 and IAD243x platforms."
      },
      {
        "revision": "2004-03-26 00:00",
        "description": "Added agent capability statements ciscoEnvMonCapCatOSV08R0101Cat6k, ciscoEnvMonCapCatOSV08R0101Cat4k, ciscoEnvMonCapV12R0119ECat6K."
      },
      {
        "revision": "1996-11-12 00:00",
        "description": "Added agent capabilities for platform c3600."
      },
      {
        "revision": "1995-01-23 00:00",
        "description": "Initial version of this MIB module."
      }
    ]
  },
