  "ianaPrinterMIB": {
    "name": "ianaPrinterMIB",
    "oid": "1.3.6.1.2.1.109",
    "class": "moduleidentity",
    "revisions": [
      {
        "revision": "2024-02-06 00:00",
        "description": "Updated PrtAlertCodeTC to cover new IPP marker state reasons."
      },
      {
        "revision": "2019-07-08 00:00",
        "description": "Updated PrtAlertGroupTC and PrtAlertCodeTC to cover groups and codes defined in Sections 5.1, 5.2, and 5.3 of PWG MFD Alerts [PWG5107.3-2019]."
      },
      {
        "revision": "2016-09-14 00:00",
        "description": "Replaced references to RFC 2911 with references to RFC8011."
      },
      {
        "revision": "2016-08-17 00:00",
        "description": "Replaced references to RFC 2910 with references to RFC 8010."
      },
      {
        "revision": "2014-05-22 00:00",
        "description": "Updated contact info."
      },
      {
        "revision": "2013-09-23 00:00",
        "description": "Added 8 in PrtInputTypeTC."
      },
      {
        "revision": "2012-07-19 00:00",
        "description": "Added 84-85 in PrtInterpreterLangFamilyTC."
      },
      {
        "revision": "2011-11-04 00:00",
        "description": "Added 35-36 in PrtMarkerSuppliesTypeTC."
      },
      {
        "revision": "2010-05-17 00:00",
        "description": "Added 72-83 in PrtInterpreterLangFamilyTC, 600+ lines from 30203-31838 in PrtAlertCodeTC."
      },
      {
        "revision": "2010-04-07 00:00",
        "description": "Added langJDF(68), langJMF(69), langPPML(70), and langXHTMLPrint(71)."
      },
      {
        "revision": "2009-11-23 00:00",
        "description": "Added langXPS(66) and langOpenXPS(67)."
      },
      {
        "revision": "2009-10-14 00:00",
        "description": "Added references for langPCLXL(47), langART(48), and langTIPSI(49)."
      },
      {
        "revision": "2009-02-06 00:00",
        "description": "Added chWSPrint(46) 'Channel Type' for Web Services based printing."
      },
      {
        "revision": "2005-09-14 00:00",
        "description": "Updates to include missing 'unknown' values for PrtCoverStatusTC, PrtChannelTypeTC, PrtAlertGroupTC and removal of comment for for PrtAlertGroupTC."
      },
      {
        "revision": "2004-06-02 00:00",
        "description": "Original version, published in coordination with Printer MIB (RFC 3805)."
      }
    ]
  },
