  "juniSnmpAgent": {
    "name": "juniSnmpAgent",
    "oid": "1.3.6.1.4.1.4874.5.2.39",
    "class": "moduleidentity",
    "revisions": [
      {
        "revision": "2003-03-10 20:27",
        "description": "Added support for management application type and MIB access permission to the Juniper-SNMP-MIB."
      },
      {
        "revision": "2002-09-06 16:54",
        "description": "Replaced Unisphere names with Juniper names."
      },
      {
        "revision": "2002-08-20 13:29",
        "description": "Added support for ping time window and notification log data inclusion in trap varbinds."
      },
      {
        "revision": "2002-08-14 19:23",
        "description": "Added support for proxy enable/disable feature."
      },
      {
        "revision": "2001-10-16 13:44",
        "description": "Added support for the snmpSetGroup. Added new objects to the Juniper-SNMP-MIB supporting interface compress, trap severities and trap severity filtering."
      },
      {
        "revision": "2001-04-13 15:44",
        "description": "The initial release of this management information module."
      }
    ]
  },
