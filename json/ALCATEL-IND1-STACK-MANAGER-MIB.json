  "alcatelIND1StackMgrMIB": {
    "name": "alcatelIND1StackMgrMIB",
    "oid": "1.3.6.1.4.1.6486.800.1.2.1.24.1",
    "class": "moduleidentity",
    "revisions": [
      {
        "revision": "2009-02-06 00:00",
        "description": "New trap alaStackMgrIncompatiblelLicenseTrap has been added."
      },
      {
        "revision": "2009-02-06 00:00",
        "description": "Added alaStackMgrOperStackingMode and alaStackMgrAdminStackingMode objects. Added AlaStackMgrStackingMode TEXTUAL-CONVENTION."
      },
      {
        "revision": "2007-04-03 00:00",
        "description": "Updated copyright information."
      },
      {
        "revision": "2005-07-15 00:00",
        "description": "New trap alaStackMgrBadMixTrap has been added. AlaStackMgrSlotState & AlaStackMgrLinkNumber textual convention have been modified."
      },
      {
        "revision": "2004-07-01 00:00",
        "description": "Updates on definitions for link states. Updates on pass through slot range."
      },
      {
        "revision": "2004-04-23 00:00",
        "description": "New trap alaStackMgrOutOfPassThruSlotsTrap has been added."
      },
      {
        "revision": "2004-04-08 00:00",
        "description": "alaStackMgrPassThruTrap has been split in three traps to assure backwards compatibility with previous releases of the OmniSwitch products."
      },
      {
        "revision": "2004-04-04 00:00",
        "description": "-Command action and command status objects added to the chassis table. -Link state textual conventions have been updated."
      },
      {
        "revision": "2004-03-22 00:00",
        "description": "Objects to handle information about token usage."
      },
      {
        "revision": "2004-03-08 00:00",
        "description": "Objects to support the pass through mode added."
      },
      {
        "revision": "2019-10-07 00:00",
        "description": "Updated the latest contact and Copyright information for ALE USA Inc."
      }
    ]
  },
