ACOS-NG-WAF-STATS-MIB DEFINITIONS ::= BEGIN
	IMPORTS
		DisplayString, PhysAddress
		FROM SNMPv2-TC
	InetAddressType
		FROM INET-ADDRESS-MIB
	acosRootStats
		FROM A10-AX-MIB
	MODULE-IDENTITY, OBJECT-TYPE, Counter32, Integer32, Counter64, OBJECT-IDENTITY, NOTIFICATION-TYPE
		FROM SNMPv2-SMI;
		acosNgWaf MODULE-IDENTITY
				LAST-UPDATED	"200705071327Z"
				ORGANIZATION	"A10 Networks, Inc."
				CONTACT-INFO	"Address: A10 Networks, Inc.
							  3 West Pumeria Dr.
							  San Jose, CA 95131
						 Phone:   +1-888-822-7210 (USA/Canada)
						          +1-408-325-8676 (International)
						 E-mail:  support@A10Networks.com"

				DESCRIPTION	 "NgWaf OID for ACOS"
				::=  {  acosRootStats 202  }

acosNgWaf                           OBJECT IDENTIFIER ::= { acosRootStats 202 }
acosNgWafStats                      OBJECT IDENTIFIER ::= { acosNgWaf 2 }
acosNgWafStatsS                     OBJECT IDENTIFIER ::= { acosNgWafStats 1 }

ngWafStatsSTable OBJECT-TYPE
		SYNTAX SEQUENCE OF NgWafStatsSEntry
		MAX-ACCESS not-accessible
		STATUS current
		::={ acosNgWafStatsS 1 } 


	ngWafStatsSEntry OBJECT-TYPE
		SYNTAX NgWafStatsSEntry
		MAX-ACCESS not-accessible
		STATUS current
		INDEX {
			name
		}
		::={ ngWafStatsSTable 1 } 


